{
  "name": "manself-backend",
  "version": "1.0.0",
  "description": "Express + Sequelize API for manself-webapp",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "sequelize-cli db:seed:all",
    "test": "node --test --test-concurrency=1",
    "test:setup": "sequelize-cli db:migrate --url \"${TEST_DATABASE_URL:-postgres://postgres:postgres@localhost:5432/manself_test}\""
  },
  "keywords": [],
  "author": "Mehmet Berk Yüksel",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
