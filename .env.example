# Copy this file to .env at the repo root (and/or backend/.env) and fill in real values.

# --- Backend ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/manself_dev

# Generate a real secret with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Enables the "Try the demo" button / POST /api/auth/demo: logs into a shared
# demo account and resets it to fresh sample data each time. Leave off for any
# real deployment.
DEMO_MODE=true

# --- docker-compose (local Postgres) ---
# Keep these in sync with DATABASE_URL above if you change them.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=manself_dev
POSTGRES_PORT=5432

# --- Future integrations (not used yet) ---
WEATHER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
