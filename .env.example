# Copy this file to .env at the repo root (and/or backend/.env) and fill in real values.

# --- Backend ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/manself_dev

# Generate a real secret with: openssl rand -hex 32
# Optional in demo mode (a random one is made for each run, so everyone is
# signed out when the server restarts). Required whenever DEMO_MODE is off.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Enables the "Try the demo" button / POST /api/auth/demo: logs into a shared
# demo account and resets it to fresh sample data each time. Leave off for any
# real deployment. (docker-compose.yml turns it on by default.)
DEMO_MODE=true

# --- docker-compose (all optional) ---
# Keep the POSTGRES_* values in sync with DATABASE_URL above if you change them.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=manself_dev
# Host ports. FRONTEND_PORT is the web app; the other two are only published
# with docker-compose.dev.yml (for running the backend/frontend outside Docker).
FRONTEND_PORT=8080
BACKEND_PORT=3000
POSTGRES_PORT=5432

# --- Weather ---
# Optional. With an OpenWeather key the app uses OpenWeather (with a daily call
# budget and caching); without one it uses Open-Meteo, which needs no key.
WEATHER_API_KEY=

# --- Future integrations (not used yet) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
